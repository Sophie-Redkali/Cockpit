# fichier comportant les clés utilisées pour le développement, les valeurs sont à adapter selon votre environnement

# SECURITY WARNING: keep the secret key used in production secret!
SECRET_KEY = a_changer
# SECURITY WARNING: don't run with debug turned on in production!
DEBUG = True
ALLOWED_HOSTS=IP_host,localhost

DB_NAME=db_name
DB_USER=db_user
DB_PASSWORD=db_password
DB_HOST=localhost
DB_PORT=5432
WEB_PORT=8000

SHAREPOINT_ENABLED=False
# authentification auprès d'Azure AD et Microsoft Graph
SP_TENANT_ID = "xxxx"       # id de l'utilisateur connecté
SP_CLIENT_ID = "xxxx"       # id de l'application enregistré dans Azure AD
SP_CLIENT_SECRET = "xxxx"   # nécessaire pour le OBO (On Behalf Of)
